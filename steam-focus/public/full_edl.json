{
 "cues": [
  {
   "from": 27,
   "to": 115,
   "text": "Questo è il nuovo ECC: REDLINE."
  },
  {
   "from": 116,
   "to": 164,
   "text": "Squadre da quattro, scivolate,"
  },
  {
   "from": 164,
   "to": 245,
   "text": "rampino e crediti da spendere in partita."
  },
  {
   "from": 263,
   "to": 329,
   "text": "Lo sviluppa Galaxy Studio,"
  },
  {
   "from": 329,
   "to": 397,
   "text": "uno studio di NetEase Games."
  },
  {
   "from": 397,
   "to": 475,
   "text": "Sarà free-to-play su PC, ma una"
  },
  {
   "from": 475,
   "to": 531,
   "text": "data d'uscita ancora non c'è."
  },
  {
   "from": 531,
   "to": 598,
   "text": "Si raccoglie equipaggiamento e si combatte"
  },
  {
   "from": 598,
   "to": 661,
   "text": "mentre la zona sicura si restringe."
  },
  {
   "from": 680,
   "to": 746,
   "text": "Il cuore del gioco è il movimento."
  },
  {
   "from": 748,
   "to": 818,
   "text": "Sprint, scivolata, mira e fuoco:"
  },
  {
   "from": 818,
   "to": 887,
   "text": "un'unica catena, senza interruzioni."
  },
  {
   "from": 887,
   "to": 932,
   "text": "Il rampino e i rimbalzi sulle"
  },
  {
   "from": 932,
   "to": 986,
   "text": "pareti allungano l'azione."
  },
  {
   "from": 986,
   "to": 1012,
   "text": "La nostra lettura:"
  },
  {
   "from": 1012,
   "to": 1071,
   "text": "se ci si sposta mentre si spara,"
  },
  {
   "from": 1071,
   "to": 1167,
   "text": "il tempismo conta quanto la copertura."
  },
  {
   "from": 1185,
   "to": 1225,
   "text": "Si gioca in quattro,"
  },
  {
   "from": 1225,
   "to": 1294,
   "text": "e ogni atleta ha un ruolo."
  },
  {
   "from": 1294,
   "to": 1356,
   "text": "C'è chi assorbe il fuoco, chi tiene in"
  },
  {
   "from": 1356,
   "to": 1437,
   "text": "vita i compagni e chi entra col rampino."
  },
  {
   "from": 1455,
   "to": 1547,
   "text": "Essere abbattuti non significa essere fuori."
  },
  {
   "from": 1547,
   "to": 1585,
   "text": "Qui un compagno rimette in"
  },
  {
   "from": 1585,
   "to": 1634,
   "text": "piedi un giocatore a terra."
  },
  {
   "from": 1634,
   "to": 1684,
   "text": "La pagina Steam descrive anche"
  },
  {
   "from": 1684,
   "to": 1735,
   "text": "uno stato di roaming: finché la"
  },
  {
   "from": 1735,
   "to": 1792,
   "text": "squadra resiste, si può rientrare."
  },
  {
   "from": 1810,
   "to": 1888,
   "text": "Eliminazioni e obiettivi danno crediti,"
  },
  {
   "from": 1888,
   "to": 1939,
   "text": "da spendere subito in armi,"
  },
  {
   "from": 1939,
   "to": 1990,
   "text": "potenziamenti e armatura."
  },
  {
   "from": 1991,
   "to": 2041,
   "text": "Nel negozio una mina adesiva"
  },
  {
   "from": 2041,
   "to": 2111,
   "text": "costa 400 crediti; una siringa"
  },
  {
   "from": 2111,
   "to": 2197,
   "text": "per rialzarsi da soli, 4.500."
  },
  {
   "from": 2198,
   "to": 2258,
   "text": "Più di dieci mine adesive:"
  },
  {
   "from": 2258,
   "to": 2366,
   "text": "una scelta tra pressione e sopravvivenza."
  },
  {
   "from": 2384,
   "to": 2463,
   "text": "Sulle armi, gli sviluppatori insistono"
  },
  {
   "from": 2463,
   "to": 2547,
   "text": "su balistica, rinculo e maneggevolezza."
  },
  {
   "from": 2547,
   "to": 2600,
   "text": "Si cambiano le parti, si montano le"
  },
  {
   "from": 2600,
   "to": 2678,
   "text": "ottiche, si regola l'impugnatura."
  },
  {
   "from": 2685,
   "to": 2764,
   "text": "E il posizionamento, tra alture, vicoli"
  },
  {
   "from": 2764,
   "to": 2864,
   "text": "e coperture, può decidere lo scontro."
  },
  {
   "from": 2882,
   "to": 2939,
   "text": "Su Steam il gioco risulta"
  },
  {
   "from": 2939,
   "to": 3018,
   "text": "in arrivo, senza una data."
  },
  {
   "from": 3040,
   "to": 3087,
   "text": "La lista dei desideri è già"
  },
  {
   "from": 3087,
   "to": 3157,
   "text": "aperta, ma l'italiano, per ora,"
  },
  {
   "from": 3157,
   "to": 3209,
   "text": "non è tra le lingue supportate."
  },
  {
   "from": 3227,
   "to": 3300,
   "text": "Secondo voi, il movimento basterà"
  },
  {
   "from": 3300,
   "to": 3356,
   "text": "a distinguerlo dagli altri tattici?"
  }
 ],
