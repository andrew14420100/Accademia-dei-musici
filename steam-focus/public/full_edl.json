{
 "cues": [
  {
   "from": 27,
   "to": 91,
   "text": "Squadre da quattro, scivolate, rampino"
  },
  {
   "from": 91,
   "to": 163,
   "text": "e crediti da spendere a metà partita."
  },
  {
   "from": 167,
   "to": 242,
   "text": "Il gioco si chiama ECC: REDLINE."
  },
  {
   "from": 263,
   "to": 313,
   "text": "Lo sviluppa Galaxy Studio,"
  },
  {
   "from": 313,
   "to": 367,
   "text": "uno studio di NetEase Games."
  },
  {
   "from": 371,
   "to": 428,
   "text": "Sarà free-to-play su PC, ma una"
  },
  {
   "from": 428,
   "to": 482,
   "text": "data d'uscita ancora non c'è."
  },
  {
   "from": 486,
   "to": 561,
   "text": "Si raccoglie equipaggiamento e si combatte"
  },
  {
   "from": 561,
   "to": 631,
   "text": "mentre la zona sicura si restringe."
  },
  {
   "from": 652,
   "to": 721,
   "text": "Il cuore del gioco è il movimento."
  },
  {
   "from": 725,
   "to": 805,
   "text": "Sprint, scivolata, mira e fuoco sono pensati"
  },
  {
   "from": 805,
   "to": 890,
   "text": "come un'unica catena, senza interruzioni."
  },
  {
   "from": 894,
   "to": 957,
   "text": "Il rampino e i rimbalzi sulle pareti"
  },
  {
   "from": 957,
   "to": 1030,
   "text": "allungano l'azione: spostarsi diventa"
  },
  {
   "from": 1030,
   "to": 1088,
   "text": "un modo per mettere pressione."
  },
  {
   "from": 1109,
   "to": 1143,
   "text": "Si gioca in quattro,"
  },
  {
   "from": 1143,
   "to": 1203,
   "text": "e ogni atleta ha un ruolo."
  },
  {
   "from": 1207,
   "to": 1265,
   "text": "C'è chi assorbe il fuoco nemico,"
  },
  {
   "from": 1265,
   "to": 1333,
   "text": "chi tiene in vita i compagni e chi entra"
  },
  {
   "from": 1333,
   "to": 1398,
   "text": "col rampino nella linea avversaria."
  },
  {
   "from": 1419,
   "to": 1513,
   "text": "Essere abbattuti non significa essere fuori."
  },
  {
   "from": 1517,
   "to": 1564,
   "text": "Qui un compagno rimette in"
  },
  {
   "from": 1564,
   "to": 1615,
   "text": "piedi un giocatore a terra."
  },
  {
   "from": 1618,
   "to": 1673,
   "text": "La pagina Steam cita anche uno stato"
  },
  {
   "from": 1673,
   "to": 1739,
   "text": "di roaming per rientrare: finché la"
  },
  {
   "from": 1739,
   "to": 1818,
   "text": "squadra resiste, il round resta aperto."
  },
  {
   "from": 1839,
   "to": 1891,
   "text": "Eliminazioni e obiettivi fanno"
  },
  {
   "from": 1891,
   "to": 1965,
   "text": "guadagnare crediti, da spendere subito"
  },
  {
   "from": 1965,
   "to": 2035,
   "text": "in armi, potenziamenti e armatura."
  },
  {
   "from": 2039,
   "to": 2096,
   "text": "Nel negozio una mina adesiva costa"
  },
  {
   "from": 2096,
   "to": 2183,
   "text": "400 crediti, e c'è perfino una siringa"
  },
  {
   "from": 2183,
   "to": 2285,
   "text": "per rialzarsi da soli, a 4.500."
  },
  {
   "from": 2289,
   "to": 2350,
   "text": "In pochi secondi, il saldo sullo"
  },
  {
   "from": 2350,
   "to": 2442,
   "text": "schermo scende da 6.000 a 3.207."
  },
  {
   "from": 2463,
   "to": 2524,
   "text": "Sulle armi, gli sviluppatori insistono"
  },
  {
   "from": 2524,
   "to": 2612,
   "text": "su balistica, rinculo e maneggevolezza."
  },
  {
   "from": 2616,
   "to": 2678,
   "text": "La modifica è libera: si cambiano"
  },
  {
   "from": 2678,
   "to": 2733,
   "text": "le parti, si montano le ottiche,"
  },
  {
   "from": 2733,
   "to": 2783,
   "text": "si regola l'impugnatura."
  },
  {
   "from": 2787,
   "to": 2854,
   "text": "E il posizionamento, tra alture, vicoli"
  },
  {
   "from": 2854,
   "to": 2930,
   "text": "e coperture, può decidere lo scontro."
  },
  {
   "from": 2951,
   "to": 2994,
   "text": "Su Steam il gioco risulta"
  },
  {
   "from": 2994,
   "to": 3052,
   "text": "in arrivo, senza una data."
  },
  {
   "from": 3056,
   "to": 3101,
   "text": "La lista dei desideri è già"
  },
  {
   "from": 3101,
   "to": 3156,
   "text": "aperta, ma l'italiano, per ora,"
  },
  {
   "from": 3156,
   "to": 3216,
   "text": "non è tra le lingue supportate."
  },
  {
   "from": 3279,
   "to": 3335,
   "text": "Questo era STEAM FOCUS."
  },
  {
   "from": 3339,
   "to": 3400,
   "text": "Secondo voi, il movimento basterà"
  },
  {
   "from": 3400,
   "to": 3468,
   "text": "a distinguerlo dagli altri tattici?"
  }
 ],
